+// With `exact_match_only` (and completion off), once the whole input is
+// matched by some phrase, drop the phrases that only match a leading part of
+// it.
+template <class Ptr>
+static void drop_partial_matches(Ptr& collector, size_t consumed) {
+  if (!collector)
+    return;
+  auto full = collector->find(consumed);
+  if (full == collector->end() || full->second.exhausted())
+    return;
+  collector->erase(collector->begin(), full);
+}
